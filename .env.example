# --- Settings (table `settings` de l'application Extensions) ---
# Recommandé : API Settings de l'application Extensions (clé à ajouter dans SETTINGS_API_KEYS de cette application)
SETTINGS_API_URL=https://extensions-lemon.vercel.app/api/settings
SETTINGS_API_KEY=
# Optionnel : extension_id propre au chatbot dans la table settings (prioritaire sur *)
SETTINGS_EXTENSION_ID=
# Recommandé : environment à utiliser (ex. qualif, prod) ; sinon celui de l'onestock_api_root retenue
ONESTOCK_ENVIRONMENT=
# Sans API Settings : accès direct à la base (DATABASE_URL ou POSTGRES_URL) et clé de déchiffrement
# DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# SETTINGS_ENCRYPTION_KEY=

# --- Extension OneStock (UI Extensibility) ---
# Optionnel : n'accepter que cet extension_id
EXTENSION_ID=
# Recommandé : n'accepter que ces site_id (ex. c42,c43) — le contexte OneStock n'est pas authentifié
ALLOWED_SITE_IDS=
# Optionnel : origines autorisées à afficher l'extension en iframe
# FRAME_ANCESTORS='self' https://*.onestock-retail.com

# --- OpenAI ---
OPENAI_API_KEY=
# Optionnel (défaut : gpt-4o)
OPENAI_MODEL=

# --- Développement local uniquement ---
# Hors back-office : ouvrir http://localhost:3000/?site_id=c42&lang=fr
# Sans DATABASE_URL : configuration OneStock prise ici plutôt que dans la table settings
# ONESTOCK_API_ROOT=https://c42.api.qualif.onestock-retail.com
# ONESTOCK_TOKEN=
# ONESTOCK_STOCK_REQUEST_NAME=

# --- Carte des magasins (facultatif) ---
# Fond de carte Leaflet (défaut : OpenStreetMap)
# NUXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap
