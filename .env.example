# --- Base partagée avec l'application Extensions (table `settings`) ---
DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Même valeur que dans l'application Extensions (déchiffre onestock_token, préfixe enc:v1:)
SETTINGS_ENCRYPTION_KEY=
# Optionnel : valeur de la colonne settings.environment à utiliser (ex. production, qualif)
ONESTOCK_ENVIRONMENT=

# --- Extension OneStock (UI Extensibility) ---
# Secret(s) fournis par OneStock, séparés par des virgules, le plus récent d'abord (rotation)
EXTENSION_SECRET_KEYS=
# Optionnel : n'accepter que cet extension_id
EXTENSION_ID=
# Optionnel : n'accepter que ces site_id (ex. c42,c43)
ALLOWED_SITE_IDS=
# Optionnel : secret de signature des sessions JWT (sinon dérivé de EXTENSION_SECRET_KEYS)
JWT_SECRET=
# Optionnel : origines autorisées à afficher l'extension en iframe
# FRAME_ANCESTORS='self' https://*.onestock-retail.com

# --- Claude ---
ANTHROPIC_API_KEY=
# Optionnel (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=

# --- Développement local uniquement ---
# Ouvrir http://localhost:3000/?site_id=c42&lang=fr sans back-office OneStock (pas de vérification de signature)
# ALLOW_DEV_SESSION=true
# Sans DATABASE_URL : configuration OneStock prise ici plutôt que dans la table settings
# ONESTOCK_API_ROOT=https://c42.api.qualif.onestock-retail.com
# ONESTOCK_TOKEN=
